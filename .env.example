# ==========================================
# BuildEstate Backend Environment Variables
# ==========================================
# Copy this file to .env (or .env.local) and fill in your actual values
# For security, never commit .env files to version control


# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=4000
NODE_ENV=development
BACKEND_URL="http://localhost:4000"


# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Connection String
# Get this from MongoDB Atlas (https://cloud.mongodb.com) or use local MongoDB
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://your_username:your_password@your_cluster.mongodb.net/buildestate?retryWrites=true&w=majority"


# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate a strong random string for JWT (use: openssl rand -base64 32)
JWT_SECRET="your_super_secure_jwt_secret_here_make_it_long_and_random"


# ===========================================
# EMAIL CONFIGURATION (Required for user notifications)
# ===========================================
# Gmail SMTP via Nodemailer
# Enable 2FA and generate App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_character_gmail_app_password"
EMAIL_USER="your_email@gmail.com"

# Admin Account Credentials (Change these!)
ADMIN_EMAIL="admin@buildestate.com"
ADMIN_PASSWORD="change_this_secure_password"


# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
# URL where your frontend is deployed
# Local: http://localhost:3000
# Vercel: https://your-project.vercel.app
WEBSITE_URL=""
# IMPORTANT: Set this to your production frontend URL (e.g. https://yourdomain.vercel.app)
# Email verification and password reset links are built from this value.
# Leaving it empty or pointing to localhost will break those emails in production.

# CORS allowlist (used by backend/server.js)
# Primary frontend URL
FRONTEND_URL="http://localhost:3000"
# Primary admin URL
ADMIN_URL="http://localhost:5174"
# Optional comma-separated local origins
LOCAL_URLS="http://localhost:3000,http://localhost:5174,http://localhost:4000"
# Optional extra origins (comma-separated)
EXTRA_ALLOWED_ORIGINS=""


# ===========================================
# IMAGE STORAGE (Required)
# ===========================================
# Cloudinary stores and delivers property images.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"


# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================

# ── Frontend ISR purge ──────────────────────────────────────────────────────
# Shared secret sent to POST <FRONTEND_URL>/api/revalidate after a blog write,
# so a published post appears on the site within seconds instead of waiting out
# the revalidate window. Must match REVALIDATE_SECRET in the frontend env.
# Leave unset to disable the purge (publishing still works, just slower).
REVALIDATE_SECRET=change-me


# ===========================================
# ENQUIRIES + SALESFORCE
# ===========================================

# Where new enquiry notifications are emailed. Falls back to ADMIN_EMAIL.
ENQUIRY_NOTIFY_EMAIL=""

# ── Salesforce: Web to Enquiry ──────────────────────────────────────────────
# Leave everything below unset and lead capture still works: enquiries save to
# MongoDB and appear in the admin panel, they just are not pushed to the CRM.
#
# Posts to Merlin's Apex service, /services/apexrest/Merlin/InsertNewEnquiry/,
# which creates an Enquiry and derives the project, source and sub-source from
# the campaign code.
#
# "enquiry-api" is assumed once the credentials below are set; "off" disables
# the push. Point a staging deploy at a sandbox or leave it off — the org in
# the integration document is PRODUCTION, and a test submission there becomes a
# real enquiry that a salesperson calls.
SALESFORCE_MODE=""

# --- Connected App ---
SALESFORCE_LOGIN_URL="https://login.salesforce.com"   # test.salesforce.com for a sandbox
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# The integration document specifies the username/password grant. Leave both
# unset to use client credentials instead, where the org has a run-as user.
SALESFORCE_USERNAME=""
SALESFORCE_PASSWORD=""
# Only if the org issues one. Merlin's documented password already has the
# token concatenated onto it, in which case leave this empty.
SALESFORCE_SECURITY_TOKEN=""
SALESFORCE_INSTANCE_URL=""                            # usually returned by auth

# --- Campaign code ---
# Campaign_Code is MANDATORY on the endpoint and nothing a visitor fills in
# supplies it, so it is resolved in this order:
#
#   1. campaignCode posted by the page (a campaign landing page knows its own).
#   2. The map below, matched against utm_id, then utm_campaign, then
#      "source:medium", then source.
#   3. SALESFORCE_DEFAULT_CAMPAIGN_CODE.
#
# Leave the default unset and every organic or direct enquiry is REJECTED —
# set it to whatever code Merlin has created for website traffic.
SALESFORCE_DEFAULT_CAMPAIGN_CODE=""
# JSON object, one line. Keys are matched case-insensitively. Optional: with no
# map, every enquiry is filed under the default code above.
#   {"facebook":"FB001","google:cpc":"GG002","brand-launch-2026":"BR010"}
SALESFORCE_CAMPAIGN_CODE_MAP=""

# Which touch is sent as the campaign attribution, and which one the campaign
# code is resolved from: first|last. The other always travels in Comments.
SALESFORCE_ATTRIBUTION_MODEL="first"

# Everything else has a working default in services/salesforceEnquiryApi.js —
# the endpoint path, +91/India as the fallback dial code and country, the
# recognised dial codes, Asia/Kolkata as the org timezone, and which UTM fields
# fill the endpoint's last two slots. Add the variable here only when Merlin
# needs one of them changed.

# ===========================================
# SPAM PROTECTION — Google reCAPTCHA v3
# ===========================================
# Asked for in the client checklist ("reCAPTCHA v3 site key and secret key").
# Create a v3 key pair at https://www.google.com/recaptcha/admin
# The SITE key goes in the frontend env; the SECRET key belongs here and must
# never be exposed to the browser.
#
# Leave unset and lead capture works exactly as before, protected by the
# honeypot alone. Failing closed on a missing key would turn a deployment
# oversight into total, silent lead loss.
RECAPTCHA_SECRET_KEY=""

# Minimum score to accept, 0.0 (bot) to 1.0 (human). Google suggests 0.5.
# Every submission's score is stored on the enquiry either way, so this can be
# tuned against real traffic instead of guessed. Raising it blocks more spam
# AND more real buyers — check the recorded scores before you move it.
RECAPTCHA_MIN_SCORE="0.5"
